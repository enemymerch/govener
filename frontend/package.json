{
  "name": "govener-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "api:generate": "node scripts/build-contract.cjs && node scripts/generate-api-types.cjs",
    "api:validate": "node scripts/validate-contract.cjs",
    "api:check": "node scripts/build-contract.cjs --check && node scripts/generate-api-types.cjs --check && node scripts/validate-contract.cjs",
    "format": "prettier --write src vite.config.ts tests playwright.config.cjs",
    "format:check": "prettier --check src vite.config.ts tests playwright.config.cjs"
  },
  "dependencies": {
    "i18next": "^25.6.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.3.5",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
