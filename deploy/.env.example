# Copy outside the repository and replace all blank secrets with random values.
GOVENER_HOST=
GOVENER_CURSOR_SECRET=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
GOVENER_MONGO_KEYFILE=/home/opc/govener-secrets/mongo-keyfile
GOVENER_ROOT_NAME=System Root
GOVENER_ROOT_EMAIL=
GOVENER_ROOT_PASSWORD=
# Enable only for the initial root creation, then disable and recreate backend.
GOVENER_ROOT_BOOTSTRAP_ENABLED=false
